# Base del API de Source Library (produccion por defecto)
SL_API_BASE=https://sourcelibrary.org

# Opcional: clave propia de API para ampliar el limite de lectura anonimo
# (500 paginas / 24 h). Se solicita en https://sourcelibrary.org/developers
# Nunca subas la clave al repositorio: usala solo en .env.local o en Vercel.
SL_API_KEY=

# Segundos de cache ISR para las respuestas del API
SL_REVALIDATE=3600
